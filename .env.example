# ===== Anthropic (الدردشة الذكية) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Facebook / Meta App =====
# من https://developers.facebook.com -> تطبيقك -> Settings > Basic
FB_APP_ID=xxxxxxxxxxxxxxx
FB_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# يجب أن يطابق تماماً رابط "Valid OAuth Redirect URIs" في إعدادات التطبيق
FB_REDIRECT_URI=https://your-domain.vercel.app/api/facebook/callback
# اختر أي نص سري من عندك، وضعه أيضاً فِ Meta for Developers > Webhooks عند إضافة رابط الـ webhook
FB_VERIFY_TOKEN=اختر-نص-سري-من-عندك

# ===== WhatsApp Cloud API =====
# من نفس تطبيق فيسبوك -> Add Product -> WhatsApp -> API Setup
WHATSAPP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
# اختر أي نص سري من عندك، ضعه أيضاً فِ إعداد Webhook الخاص بواتساب
WHATSAPP_VERIFY_TOKEN=اختر-نص-سري-من-عندك

# ===== Vercel KV (لتخزين الطلبات وتوكنات فيسبوك بشكل دائم) =====
# تُنشأ تلقائياً عند ربط قاعدة بيانات KV من لوحة Vercel، ثم تُنسخ هذه القيم من هناك
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== الأخبار (اختياري — يفعّل "آخر الأخبار" فِ ذاكرة الوكيل) =====
# مفتاح مجاني من https://newsapi.org
NEWS_API_KEY=
# كلمات البحث الافتراضية (اختياري)
NEWS_QUERY=موريتانيا OR تقنية OR اقتصاد
# نص سري تختاره لحماية رابط جلب الأخبار من الاستدعاء العشوائي (اختياري لكن موصى به)
CRON_SECRET=اختر-نص-سري-من-عندك
